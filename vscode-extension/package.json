{
  "name": "nestify-extension",
  "displayName": "Nestify",
  "version": "0.0.1",
  "publisher": "nestify",
  "engines": { "vscode": ">=1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onCommand:nestify.openChat"],
  "contributes": {
    "commands": [
      { "command": "nestify.openChat", "title": "Nestify: Open Chat" }
    ],
    "configuration": {
      "type": "object",
      "properties": {
        "nestify.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable to run the bridge (e.g., venv Scripts/python.exe)."
        }
      }
    }
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
